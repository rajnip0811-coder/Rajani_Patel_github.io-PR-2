<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>City Care Hospital</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#eefbfb; --surface:#f6fffe; --ink:#122522; --ink-soft:#4d6360; --ink-faint:#93a6a3;
  --line:rgba(14,86,86,.10); --accent:#0e7c86; --accent-2:#e0435e; --accent-tint:#e2f5f4; --red-tint:#fdeaee;
  --radius:20px; --shadow-sm:0 1px 3px rgba(0,0,0,.05); --shadow-md:0 12px 30px rgba(0,0,0,.09);
  --ease:cubic-bezier(.16,.84,.44,1);
}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:linear-gradient(180deg,#eefbfb 0%,#e3f6f4 45%,#eefbfb 100%);color:var(--ink);font-family:'Inter',system-ui,sans-serif;line-height:1.65;}
h1,h2,h3{font-family:'Manrope','Inter',sans-serif;font-weight:800;letter-spacing:-.02em;color:var(--ink);}
.wrap{max-width:980px;margin:0 auto;padding:0 26px;}
a{color:inherit;}
nav{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.88);backdrop-filter:blur(14px);border-bottom:1px solid var(--line);}
.nav-inner{max-width:980px;margin:0 auto;padding:16px 26px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;}
.brand{font-family:'Manrope',sans-serif;font-weight:800;font-size:1.1rem;}
.nav-links{display:flex;gap:4px;flex-wrap:wrap;}
.nav-links a{text-decoration:none;font-size:.92rem;font-weight:600;color:var(--ink-soft);padding:8px 14px;border-radius:999px;transition:background .25s,color .25s;}
.nav-links a:hover{background:var(--accent-tint);color:var(--accent);}
header.hero{text-align:center;padding:74px 0 56px;background:linear-gradient(180deg,var(--accent-tint),transparent);}
header.hero h1{font-size:clamp(2.1rem,4.6vw,3.1rem);margin-bottom:10px;}
header.hero .tag{color:var(--ink-soft);font-size:1.12rem;margin-bottom:26px;}
.hero-icon{width:92px;height:92px;margin:0 auto 22px;color:var(--accent);}
.hero-icon svg{width:100%;height:100%;}
section{padding:56px 0;}
section h2{font-size:1.7rem;margin-bottom:22px;}
.eyebrow{display:block;color:var(--accent);font-weight:700;font-size:.78rem;letter-spacing:.05em;text-transform:uppercase;margin-bottom:8px;}
p.lead{color:var(--ink-soft);max-width:680px;margin-bottom:8px;}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:18px;margin-top:18px;}
.card{background:var(--accent-tint);border:1px solid var(--line);border-left:4px solid var(--accent);border-radius:var(--radius);padding:24px;box-shadow:var(--shadow-sm);transition:transform .3s var(--ease),box-shadow .3s var(--ease),border-color .3s;}
.card:hover{transform:translateY(-4px);box-shadow:var(--shadow-md);border-color:var(--accent);}
.card:nth-child(even){background:var(--red-tint);border-left-color:var(--accent-2);}
.card:nth-child(even) .ic{background:#fff;color:var(--accent-2);}
.card .ic{width:38px;height:38px;border-radius:11px;background:#fff;color:var(--accent);display:flex;align-items:center;justify-content:center;margin-bottom:14px;box-shadow:var(--shadow-sm);}
.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:16px;margin-top:18px;}
.stat{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:22px;text-align:center;box-shadow:var(--shadow-sm);}
.stat .num{font-family:'Manrope',sans-serif;font-weight:800;font-size:1.9rem;color:var(--accent);}
.stat .lbl{color:var(--ink-soft);font-size:.82rem;margin-top:4px;}
.card .ic svg{width:20px;height:20px;}
.card h3{font-size:1.02rem;margin-bottom:4px;}
.card p{color:var(--ink-soft);font-size:.92rem;}
.table-wrap{border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow-sm);margin-top:18px;}
table{width:100%;border-collapse:collapse;}
th,td{text-align:left;padding:14px 20px;font-size:.94rem;}
thead th{background:var(--accent);color:#fff;font-family:'Manrope',sans-serif;font-weight:700;font-size:.78rem;letter-spacing:.03em;text-transform:uppercase;}
tbody tr{border-bottom:1px solid var(--line);}
tbody tr:last-child{border-bottom:none;}
tbody tr:hover{background:var(--accent-tint);}
tbody td:first-child{font-weight:600;}
ol.notice{list-style:none;margin-top:14px;}
ol.notice li{position:relative;padding:14px 0 14px 38px;border-bottom:1px solid var(--line);color:var(--ink-soft);counter-increment:n;}
ol.notice{counter-reset:n;}
ol.notice li:last-child{border-bottom:none;}
ol.notice li::before{content:counter(n);position:absolute;left:0;top:12px;width:22px;height:22px;border-radius:7px;background:var(--accent);color:#fff;font-size:.72rem;font-weight:700;display:flex;align-items:center;justify-content:center;}
.callout{background:var(--accent);color:#fff;border-radius:var(--radius);padding:26px 28px;margin-top:18px;}
.callout h3{color:#fff;font-size:1.15rem;}
.callout p{color:rgba(255,255,255,.88);margin-top:4px;}
.btn{display:inline-flex;align-items:center;gap:8px;padding:13px 26px;border-radius:999px;background:var(--accent);color:#fff;text-decoration:none;font-weight:700;font-size:.92rem;box-shadow:var(--shadow-sm);transition:transform .25s,box-shadow .25s;margin-top:8px;}
.btn:hover{transform:translateY(-2px);box-shadow:var(--shadow-md);}
footer{border-top:1px solid var(--line);background:var(--surface);text-align:center;padding:34px 0;color:var(--ink-soft);font-size:.9rem;}
footer .brand{display:block;margin-bottom:6px;color:var(--ink);}
@media(max-width:640px){ section{padding:40px 0;} header.hero{padding:56px 0 40px;} }
</style>
</head>
<body>
